# Web Wallpaper Store — Firebase configuration
#
# Copy this file to `config.env` (same directory) and fill in YOUR values,
# then rebuild. The real `config.env` is gitignored so your credentials never
# get committed to source control.
#
# Create a Firestore "wallpapers" catalog under this project to use.

FIREBASE_API_KEY=your_api_key_here
FIREBASE_PROJECT_ID=your_project_id_here
FIREBASE_DATABASE_ID=your_database_id_here